{
  "name": "iac",
  "version": "0.2.0",
  "bin": {
    "iac": "bin/iac.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "validate": "bash scripts/validate-config.sh",
    "validate:offline": "bash scripts/validate-config.sh --skip-aws",
    "predeploy": "npm run validate",
    "deploy": "cdk deploy",
    "deploy:full": "bash scripts/deploy-with-update.sh",
    "deploy:update-cognito": "bash scripts/deploy-with-update.sh --stage2-only",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --check \"**/*.{ts,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.72.2",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "aws-cdk": "2.1148.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "cdk-nag": "^2.38.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.276.0",
    "constructs": "^10.8.1"
  },
  "overrides": {
    "fast-uri": ">=3.1.4",
    "brace-expansion": ">=5.0.12",
    "aws-cdk-lib": {
      "fast-uri": ">=3.1.4",
      "brace-expansion": ">=5.0.12",
      "minimatch": {
        "brace-expansion": ">=5.0.12"
      }
    },
    "handlebars": ">=4.7.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
